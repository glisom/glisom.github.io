---
interface Props {
  ownership: 'made' | 'used';
}

const { ownership } = Astro.props;
const label = ownership === 'made' ? 'Made by Grant' : 'Used by Grant';
---

<span
  class:list={['ownership-stamp', `ownership-stamp--${ownership}`]}
  data-ownership={ownership}
  data-surface={ownership === 'made' ? 'lime' : 'blue'}
>
  {label}
</span>
