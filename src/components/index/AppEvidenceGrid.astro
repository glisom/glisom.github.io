---
import { recordDestination } from '../../lib/content/destination';
import type { ProjectRecord } from '../../types/content';
import HalftoneImage from '../media/HalftoneImage.astro';
import Icon from '../media/Icon.astro';

interface Props {
  records: readonly ProjectRecord[];
}

const { records } = Astro.props;
const isArchived = (record: ProjectRecord) =>
  /archived|dormant|offline|retired/i.test(record.data.status);
const current = records.filter((record) => !isArchived(record));
const archived = records.filter(isArchived);
const ordered = [...current, ...archived];
const destinationFor = recordDestination;
const artById: Partial<
  Record<ProjectRecord['id'], { src: string; alt: string }>
> = {
  'hermes-ios': {
    src: 'evidence/healthql-hands.png',
    alt: 'A sequence of fine-line blue hand gestures',
  },
  listwithme: {
    src: 'evidence/listwithme-hand.png',
    alt: 'A fine blue halftone drawing of a hand holding a pen',
  },
  healthql: {
    src: 'evidence/evidence-map.png',
    alt: 'Abstract blue halftone terrain marked with system checkpoints',
  },
};
---

<div class="app-grid">
  {
    ordered.map((record, index) => {
      const archivedRecord = isArchived(record);
      const art = artById[record.id];
      const destination = destinationFor(record);
      return (
        <article
          class:list={[
            'app-card',
            { featured: index === 0, 'text-only': !art },
          ]}
          data-app-record
          data-app-state={archivedRecord ? 'archived' : 'current'}
        >
          {art && (
            <HalftoneImage
              class="app-art"
              src={art.src}
              alt={art.alt}
              widths={[400, 640, 800, 1000]}
              sizes="(max-width: 820px) calc(100vw - 36px), (max-width: 1023px) calc(100vw - 286px), (max-width: 1219px) 39vw, 36vw"
            />
          )}
          <div class="app-copy">
            <div class="card-top">
              <span class="card-kicker" data-record-status>
                {record.data.status}
              </span>
              <span class="card-number">
                {String(index + 1).padStart(2, '0')}
              </span>
            </div>
            <h2>{record.data.title}</h2>
            <p data-record-summary>{record.data.summary}</p>
            <p class="app-platform" data-record-platform>
              {record.data.platform}
            </p>
            {record.data.actionState && (
              <p class="action-state" data-action-state>
                {record.data.actionState}
              </p>
            )}
            {destination && (
              <a class="arrow-link" href={destination} data-record-action>
                <span>Visit the project</span>
                <Icon name="arrow-right" decorative={true} />
              </a>
            )}
          </div>
        </article>
      );
    })
  }
</div>
