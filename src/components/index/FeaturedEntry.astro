---
import type { BlogRecord } from '../../types/content';
import HalftoneImage from '../media/HalftoneImage.astro';
import Icon from '../media/Icon.astro';

interface Props {
  record: BlogRecord;
}

const { record } = Astro.props;
const featureArt = record.data.featuredArt;
---

<article class:list={['featured-story', { 'has-art': featureArt }]}>
  <div class="featured-copy">
    <span class="card-kicker">Featured post · {record.data.kind}</span>
    <h2>{record.data.title}</h2>
    <p>{record.data.summary}</p>
    <a class="arrow-link" href={record.data.canonicalPath}>
      <span>Read the story</span><Icon name="arrow-right" decorative={true} />
    </a>
  </div>
  {
    featureArt && (
      <HalftoneImage
        class="featured-art"
        src={featureArt.src}
        alt={featureArt.alt}
        decorative={featureArt.decorative}
        widths={[140, 280, 420]}
        sizes="(max-width: 640px) 80px, 140px"
      />
    )
  }
</article>
