---
import type { BlogRecord } from '../../types/content';
import HalftoneImage from '../media/HalftoneImage.astro';
import Icon from '../media/Icon.astro';

interface Props {
  record: BlogRecord;
}

const { record } = Astro.props;
---

<article class="featured-story" data-surface="black">
  <div class="featured-copy">
    <span class="card-kicker">Featured post · {record.data.kind}</span>
    <h2>{record.data.title}</h2>
    <p>{record.data.summary}</p>
    <a class="arrow-link" href={record.data.canonicalPath}>
      <span>Read the story</span><Icon name="arrow-right" decorative={true} />
    </a>
  </div>
  <HalftoneImage
    class="featured-art"
    src="evidence/production-hands.png"
    alt="Two blue halftone hands reaching toward one another"
    widths={[400, 640, 800, 1000]}
    sizes="(max-width: 820px) calc(100vw - 36px), (max-width: 1023px) calc(100vw - 286px), (max-width: 1219px) 37vw, 34vw"
  />
</article>
