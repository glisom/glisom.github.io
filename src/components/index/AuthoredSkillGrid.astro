---
import { recordDestination } from '../../lib/content/destination';
import type { SkillRecord } from '../../types/content';
import HalftoneImage from '../media/HalftoneImage.astro';
import Icon from '../media/Icon.astro';

interface Props {
  records: readonly SkillRecord[];
}

const { records } = Astro.props;
const destinationFor = recordDestination;
---

<section class="authored-intro" data-surface="black">
  <div class="authored-intro-copy">
    <span>Made by Grant</span>
    <p>
      Instructions that teach an AI tool how to handle a particular task, from
      drafting a reply to backing up my books.
    </p>
  </div>
  <HalftoneImage
    class="authored-art"
    src="evidence/belief-rings.png"
    alt="Concentric acid-lime halftone rings"
    widths={[320, 480, 640, 800]}
    sizes="(max-width: 820px) calc(100vw - 36px), (max-width: 1023px) 37vw, (max-width: 1219px) 31vw, 27vw"
  />
</section>
<div
  class="authored-skill-grid"
  style={`--skill-columns: ${records.length % 3 === 0 ? 3 : 2}`}
>
  {
    records.map((record) => {
      const destination = destinationFor(record);
      return (
        <article class="authored-skill-card" data-authored-skill>
          <span class="ownership-stamp" data-ownership-stamp>
            Made by Grant
          </span>
          <span class="authored-skill-status" data-record-status>
            {record.data.status}
          </span>
          <h2>{record.data.title}</h2>
          <p>{record.data.summary}</p>
          <p class="supported-tools" data-supported-tools>
            <strong>Works with</strong> {record.data.supportedTools.join(', ')}
          </p>
          {record.data.actionState && (
            <p class="action-state" data-action-state>
              {record.data.actionState}
            </p>
          )}
          {destination && (
            <a class="arrow-link" href={destination} data-record-action>
              <span>View source</span>
              <Icon name="arrow-right" decorative={true} />
            </a>
          )}
        </article>
      );
    })
  }
</div>
