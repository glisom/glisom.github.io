---
import ResponsiveImage from './ResponsiveImage.astro';

interface Props {
  src: string;
  alt: string;
  decorative?: boolean;
  widths?: number[];
  sizes?: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
}

const {
  src,
  alt,
  decorative = false,
  widths,
  sizes,
  loading,
  fetchpriority,
  class: className,
} = Astro.props;
---

<div
  class:list={[
    'halftone-image',
    { 'halftone-image--dark': src === 'evidence/vampire-laptop.png' },
    className,
  ]}
  data-halftone-image
>
  <ResponsiveImage
    src={src}
    alt={alt}
    decorative={decorative}
    widths={widths}
    sizes={sizes}
    loading={loading}
    fetchpriority={fetchpriority}
    class="halftone-image__asset"
  />
</div>

<style>
  .halftone-image {
    max-inline-size: 100%;
    overflow: hidden;
    background: var(--paper-bright);
  }

  .halftone-image :global(picture),
  .halftone-image :global(img) {
    width: 100%;
    height: 100%;
  }

  .halftone-image :global(img) {
    object-fit: cover;
    filter: invert(1) hue-rotate(180deg) saturate(0.55);
    mix-blend-mode: screen;
  }
  .halftone-image--dark :global(img) {
    filter: saturate(0.65) contrast(1.3) brightness(1.1);
  }
  .halftone-image--fine :global(img) {
    filter: grayscale(1) invert(1) brightness(3);
  }
</style>
