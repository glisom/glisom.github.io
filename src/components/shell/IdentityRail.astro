---
import SiteMark from './SiteMark.astro';
import { ABOUT_LINK, NAVIGATION } from '../../data/navigation';
import { SITE } from '../../data/site';
import type { PrimaryCollection, RailContext } from '../../types/content';

interface Props {
  activeCollection?: PrimaryCollection;
  activeAbout?: boolean;
  railContext: RailContext;
}
const { activeCollection, activeAbout = false } = Astro.props;
---

<header class="identity-rail" aria-label="Site navigation">
  <a class="rail-identity" href="/" aria-label="Grant Isom, home">
    <SiteMark />
    <span class="identity-copy"><strong>{SITE.name}</strong></span>
  </a>
  <nav class="rail-nav" aria-label="Browse">
    {
      NAVIGATION.map((item) => (
        <div
          class:list={[
            'rail-nav-item',
            { 'is-active': item.id === activeCollection },
          ]}
        >
          <a
            href={item.href}
            aria-current={item.id === activeCollection ? 'page' : undefined}
          >
            {item.label}
          </a>
        </div>
      ))
    }
    <div class:list={['rail-nav-item', { 'is-active': activeAbout }]}>
      <a href={ABOUT_LINK.href} aria-current={activeAbout ? 'page' : undefined}
        >{ABOUT_LINK.label}</a
      >
    </div>
  </nav>
</header>
