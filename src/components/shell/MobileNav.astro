---
import { NAVIGATION } from '../../data/navigation';
import { SITE } from '../../data/site';
import type { PrimaryCollection } from '../../types/content';

interface Props {
  activeCollection?: PrimaryCollection;
  activeAbout?: boolean;
}

const { activeCollection, activeAbout = false } = Astro.props;
---

<details class="mobile-nav">
  <summary>Browse</summary>
  <nav aria-label="Mobile browse">
    {
      NAVIGATION.map((item) => {
        const isActive = item.id === activeCollection;
        return (
          <div class:list={['mobile-nav-row', { 'is-active': isActive }]}>
            <a href={item.href} aria-current={isActive ? 'page' : undefined}>
              {item.label}
            </a>
            {isActive && (
              <span class="mobile-nav-state" data-utility-label>
                Current
              </span>
            )}
          </div>
        );
      })
    }
    <div class:list={['mobile-nav-row', { 'is-active': activeAbout }]}>
      <a href="/about/" aria-current={activeAbout ? 'page' : undefined}>
        About
      </a>
      {
        activeAbout && (
          <span class="mobile-nav-state" data-utility-label>
            Current
          </span>
        )
      }
    </div>
    <div class="mobile-nav-row"><a href="/feed.xml">RSS</a></div>
    <div class="mobile-nav-row"><a href={`mailto:${SITE.email}`}>Email</a></div>
  </nav>
</details>
