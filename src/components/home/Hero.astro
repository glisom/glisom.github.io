---
import HalftoneImage from '../media/HalftoneImage.astro';
---

<section class="home-hero" data-home-hero aria-labelledby="home-hero-title">
  <div class="hero-copy">
    <h1 id="home-hero-title" class="sr-only">Grant Isom</h1>
    <p class="hero-intro">
      I’m Grant, a software engineer building AI agents at Limelight and running
      Groundwork AI. This is where I share what I’m making and learning.
    </p>
    <a class="home-about" href="/about/">A little more about me</a>
  </div>
  <HalftoneImage
    class="hero-art"
    src="evidence/evidence-map.png"
    alt="Abstract blue halftone terrain marked with system checkpoints"
    widths={[240, 360, 480]}
    sizes="(max-width: 640px) 120px, 180px"
    loading="eager"
  />
</section>
