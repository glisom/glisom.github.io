---
import type { HomepageContent } from '../../types/content';
import { recordDestination } from '../../lib/content/destination';
import Icon from '../media/Icon.astro';

interface Props {
  content: HomepageContent;
}
const { content } = Astro.props;
const posts = [content.featuredWriting, ...content.latestPosts];
const projects = [
  content.featuredProjectPrimary,
  content.featuredProjectSecondary,
];
---

<div class="home-index">
  <section class="home-section" aria-labelledby="home-writing-title">
    <div class="home-section-heading">
      <h2 id="home-writing-title">Writing</h2>
      <a href="/blog/"
        >All writing <Icon name="arrow-right" decorative={true} /></a
      >
    </div>
    <ul class="home-posts">
      {
        posts.map((record) => (
          <li data-post-row>
            <a href={record.data.canonicalPath}>
              <span>{record.data.title}</span>
              <Icon name="arrow-right" decorative={true} />
            </a>
          </li>
        ))
      }
    </ul>
  </section>
  <section class="home-section" aria-labelledby="home-projects-title">
    <div class="home-section-heading">
      <h2 id="home-projects-title">Selected projects</h2>
      <a href="/projects/"
        >All projects <Icon name="arrow-right" decorative={true} /></a
      >
    </div>
    <ul class="home-projects">
      {
        projects.map((record) => (
          <li>
            <a href={recordDestination(record)}>
              <span>
                <strong>{record.data.title}</strong>
                <span class="home-project-summary">{record.data.summary}</span>
              </span>
              <Icon name="arrow-right" decorative={true} />
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</div>
