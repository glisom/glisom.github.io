---
import { recordDestination } from '../../lib/content/destination';
import type { AppLibraryRecord } from '../../types/content';
import Icon, { type IconName } from '../media/Icon.astro';

interface Props {
  records: readonly AppLibraryRecord[];
}

const { records } = Astro.props;
const appIcons: Record<string, IconName> = {
  obsidian: 'books',
  codex: 'code',
  'hermes-agent': 'robot',
  superhuman: 'envelope-simple',
  notion: 'books',
  claude: 'asterisk',
  linear: 'stack-simple',
  slack: 'envelope-simple',
};
---

<article
  class="card method-card"
  data-home-slot="app-library"
  aria-labelledby="app-library-title"
>
  <div class="card-label-row">
    <span class="card-kicker" data-utility-label>App Library</span>
    <span class="card-number" data-utility-label>04</span>
  </div>
  <h2 id="app-library-title">In my toolkit.</h2>
  <p class="method-intro">A few of the apps I use.</p>
  <ol class="method-list">
    {
      records.map((record, index) => (
        <li>
          <a href={recordDestination(record)}>
            <span data-utility-label>{String(index + 1).padStart(2, '0')}</span>
            <Icon name={appIcons[record.id] ?? 'asterisk'} decorative={true} />
            <strong data-record-title>{record.data.title}</strong>
            <Icon name="arrow-right" decorative={true} />
          </a>
        </li>
      ))
    }
  </ol>
</article>
