---
import { recordDestination } from '../../lib/content/destination';
import type { ProjectRecord } from '../../types/content';
import HalftoneImage from '../media/HalftoneImage.astro';
import Icon from '../media/Icon.astro';

interface Props {
  record: ProjectRecord;
  slot: 'featured-project-primary' | 'featured-project-secondary';
  number: '02' | '03';
  variant: 'primary' | 'secondary';
  art: { src: string; alt: string };
}

const { record, slot, number, variant, art } = Astro.props;

const imageSizes =
  variant === 'primary'
    ? '(max-width: 820px) 66vw, (max-width: 1120px) 38vw, (max-width: 1219px) calc(50vw - 140px), (max-width: 1320px) calc(50vw - 166px), 20vw'
    : '(max-width: 820px) 66vw, (max-width: 1120px) 38vw, (max-width: 1219px) calc(33vw - 92px), (max-width: 1320px) calc(33vw - 109px), 20vw';
---

<article
  class:list={[
    'card',
    'project-card',
    variant === 'primary' ? 'healthql-card' : 'list-card',
  ]}
  data-home-slot={slot}
  aria-labelledby={`${slot}-title`}
>
  <div class="card-label-row">
    <span class="card-kicker" data-utility-label>
      My Apps · {record.data.status}
    </span>
    <span class="card-number" data-utility-label>{number}</span>
  </div>
  <h2 id={`${slot}-title`}>{record.data.title}</h2>
  <p>{record.data.summary}</p>
  <HalftoneImage
    class="project-art"
    src={art.src}
    alt={art.alt}
    widths={[320, 480, 640, 720]}
    sizes={imageSizes}
  />
  <a class="arrow-link" href={recordDestination(record)}>
    <span>Open the project</span>
    <Icon name="arrow-right" decorative={true} />
  </a>
</article>
