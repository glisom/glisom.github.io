---
import type { SkillRecord } from '../../types/content';
import HalftoneImage from '../media/HalftoneImage.astro';

interface Props {
  records: readonly SkillRecord[];
}

const { records } = Astro.props;
---

<article
  class="card beliefs-card"
  data-home-slot="my-skills"
  aria-labelledby="my-skills-title"
>
  <HalftoneImage
    class="belief-art"
    src="evidence/belief-rings.png"
    alt="Concentric lime halftone rings"
    widths={[210, 320, 420]}
    sizes="(max-width: 820px) 43vw, (max-width: 1320px) 20vw, 10vw"
  />
  <div>
    <div class="card-label-row">
      <span class="card-kicker" data-utility-label>My Skills</span>
      <span class="card-number" data-utility-label>06</span>
    </div>
    <h2 id="my-skills-title">Three skills I made for myself.</h2>
    <p class="personal-skill-list">
      {
        records.map((record, index) => (
          <>
            {index > 0 && <span aria-hidden="true"> · </span>}
            <a href={record.data.canonicalPath} data-record-title>
              {record.data.title}
            </a>
          </>
        ))
      }
    </p>
  </div>
</article>
